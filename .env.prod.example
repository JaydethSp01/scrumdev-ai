# =============================================================================
# .env.prod.example
# Copia este archivo a `.env` en el VPS de producción y rellena los valores.
# NO commits con secretos reales.
# =============================================================================

# ===== Aplicación =====
APP_ENV=production
APP_NAME=ScrumDev AI
APP_DEBUG=false

# ===== Imágenes Docker (tag controlable por release) =====
IMAGE_TAG=latest
BACKEND_IMAGE=ghcr.io/<owner>/scrumdev-backend
FRONTEND_IMAGE=ghcr.io/<owner>/scrumdev-frontend

# Puerto público del nginx (80 por default, 8088 para staging coexistiendo)
HTTP_PORT=80

# ===== Postgres (interno al stack) =====
POSTGRES_USER=scrumdev
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
POSTGRES_DB=scrumdev_ai

# El DATABASE_URL se reconstruye en docker-compose.prod.yml a partir de las vars
# de arriba; lo dejamos por si algún script local lo necesita:
DATABASE_URL=postgresql+asyncpg://scrumdev:<CHANGE_ME_STRONG_PASSWORD>@postgres:5432/scrumdev_ai

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== RabbitMQ =====
RABBITMQ_ENABLED=true
RABBITMQ_USER=scrumdev
RABBITMQ_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
RABBITMQ_URL=amqp://scrumdev:<CHANGE_ME_STRONG_PASSWORD>@rabbitmq:5672/

# ===== Temporal =====
TEMPORAL_ENABLED=true
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=scrumdev-ai-task-queue

# ===== Puertos de servicios (interno - NO exponer al host) =====
API_GATEWAY_PORT=8080
CONVERSATION_SERVICE_PORT=8001
ORCHESTRATOR_SERVICE_PORT=8002
AGENT_RUNTIME_SERVICE_PORT=8003
JIRA_CONNECTOR_SERVICE_PORT=8004
GIT_CONNECTOR_SERVICE_PORT=8005
DEPLOY_CONNECTOR_SERVICE_PORT=8006
POLICY_SERVICE_PORT=8007
MEMORY_SERVICE_PORT=8008
AUDIT_SERVICE_PORT=8009

# URLs internas (resueltas por DNS de docker)
CONVERSATION_SERVICE_URL=http://conversation_service:8001
ORCHESTRATOR_SERVICE_URL=http://orchestrator_service:8002
AGENT_RUNTIME_SERVICE_URL=http://agent_runtime_service:8003
JIRA_CONNECTOR_SERVICE_URL=http://jira_connector_service:8004
GIT_CONNECTOR_SERVICE_URL=http://git_connector_service:8005
DEPLOY_CONNECTOR_SERVICE_URL=http://deploy_connector_service:8006
POLICY_SERVICE_URL=http://policy_service:8007
MEMORY_SERVICE_URL=http://memory_service:8008
AUDIT_SERVICE_URL=http://audit_service:8009

# ===== Frontend =====
# El front habla con el gateway vía el reverse proxy (/api)
NEXT_PUBLIC_API_GATEWAY_URL=/api

# ===== Integraciones externas =====
SCRUMDEV_JIRA_BASE_URL=https://<your-org>.atlassian.net
SCRUMDEV_JIRA_EMAIL=
SCRUMDEV_JIRA_API_TOKEN=
SCRUMDEV_JIRA_PROJECT_KEY=SDAI

SCRUMDEV_GIT_PROVIDER=github
SCRUMDEV_GIT_TOKEN=
SCRUMDEV_GIT_OWNER=
SCRUMDEV_GIT_REPO=

# ===== Proveedor LLM =====
# En prod recomendado: anthropic (api key) - claude_code requiere binario en el host
SCRUMDEV_AI_PROVIDER=anthropic
SCRUMDEV_AI_API_KEY=
SCRUMDEV_AI_MODEL=claude-sonnet-4-6
CLAUDE_CODE_BIN=

# ===== Deploy externo (opcional) =====
SCRUMDEV_DEPLOY_PROVIDER=render
SCRUMDEV_DEPLOY_API_TOKEN=

# ===== Seguridad =====
# Generar con: openssl rand -hex 32
JWT_SECRET_KEY=<CHANGE_ME_OPENSSL_RAND_HEX_32>
JWT_ALGORITHM=HS256

# ===== CORS =====
# Lista separada por comas con los dominios públicos del front
CORS_ALLOWED_ORIGINS=https://app.scrumdev.example.com

# ===== Uvicorn (tuning por servicio) =====
UVICORN_WORKERS=2
UVICORN_LOG_LEVEL=info
