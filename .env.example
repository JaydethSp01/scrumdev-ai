# ===== Aplicacion =====
APP_ENV=local
APP_NAME=ScrumDev AI
APP_DEBUG=true

# ===== Puertos de servicios (locales) =====
API_GATEWAY_PORT=8080
CONVERSATION_SERVICE_PORT=8001
ORCHESTRATOR_SERVICE_PORT=8002
AGENT_RUNTIME_SERVICE_PORT=8003
JIRA_CONNECTOR_SERVICE_PORT=8004
GIT_CONNECTOR_SERVICE_PORT=8005
DEPLOY_CONNECTOR_SERVICE_PORT=8006
POLICY_SERVICE_PORT=8007
MEMORY_SERVICE_PORT=8008
AUDIT_SERVICE_PORT=8009
NOTIFICATION_SERVICE_PORT=8010
AUTH_SERVICE_PORT=8011
USER_SERVICE_PORT=8012

# URLs internas (cuando se ejecuta todo local con uvicorn)
CONVERSATION_SERVICE_URL=http://localhost:8001
ORCHESTRATOR_SERVICE_URL=http://localhost:8002
AGENT_RUNTIME_SERVICE_URL=http://localhost:8003
JIRA_CONNECTOR_SERVICE_URL=http://localhost:8004
GIT_CONNECTOR_SERVICE_URL=http://localhost:8005
DEPLOY_CONNECTOR_SERVICE_URL=http://localhost:8006
POLICY_SERVICE_URL=http://localhost:8007
MEMORY_SERVICE_URL=http://localhost:8008
AUDIT_SERVICE_URL=http://localhost:8009
NOTIFICATION_SERVICE_URL=http://localhost:8010
AUTH_SERVICE_URL=http://localhost:8011
USER_SERVICE_URL=http://localhost:8012
ML_SERVICE_URL=http://localhost:8013

# ===== Machine Learning =====
ML_ENABLED=true
ML_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ML_CACHE_DIR=./ml_cache

# ===== Infraestructura =====
DATABASE_URL=postgresql+asyncpg://scrumdev:scrumdev@localhost:5434/scrumdev_ai
REDIS_URL=redis://localhost:6379/0

# Temporal (opcional, default deshabilitado en fase 1)
TEMPORAL_ENABLED=false
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=scrumdev-ai-task-queue

# RabbitMQ (opcional, default deshabilitado en fase 1)
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ===== Integraciones externas =====
SCRUMDEV_JIRA_BASE_URL=
SCRUMDEV_JIRA_EMAIL=
SCRUMDEV_JIRA_API_TOKEN=
SCRUMDEV_JIRA_PROJECT_KEY=SDAI

SCRUMDEV_GIT_PROVIDER=github
SCRUMDEV_GIT_TOKEN=
SCRUMDEV_GIT_OWNER=
SCRUMDEV_GIT_REPO=

# ===== Proveedor LLM =====
# Opciones:
#   claude_code  -> usa Claude Code SDK (tu plan Pro/Max, SIN API key)
#   anthropic    -> usa la API de Anthropic (requiere SCRUMDEV_AI_API_KEY)
#   openai       -> usa la API de OpenAI    (requiere SCRUMDEV_AI_API_KEY)
SCRUMDEV_AI_PROVIDER=claude_code
SCRUMDEV_AI_API_KEY=
SCRUMDEV_AI_MODEL=claude-sonnet-4-6

# Solo aplica si SCRUMDEV_AI_PROVIDER=claude_code
# Ruta opcional al binario claude (default: usa el del PATH)
CLAUDE_CODE_BIN=

# ===== Deploy =====
SCRUMDEV_DEPLOY_PROVIDER=render
SCRUMDEV_DEPLOY_API_TOKEN=

# ===== Seguridad =====
JWT_SECRET_KEY=change-me-in-production-please
JWT_ALGORITHM=HS256

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== F2 webhooks (necesarios para activar webhooks reales) =====
# Jira: en tu Jira workspace, configurar webhook con este secret
JIRA_WEBHOOK_SECRET=
# GitHub: en cada repo, configurar webhook content-type=application/json + este secret
GITHUB_WEBHOOK_SECRET=

# ===== F2 connector providers (intercambiables) =====
ISSUE_TRACKER_PROVIDER=jira
VERSION_CONTROL_PROVIDER=github

# ===== F2 ADR persistence =====
ADR_ROOT=docs/adr
